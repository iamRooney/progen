{
  "name": "setupkaro",
  "version": "0.1.0",
  "description": "Zero-install CLI to generate production-ready project templates in one command. Includes linting, testing, CI/CD, Docker, and README. Templates: TypeScript, React, Next.js, Python FastAPI, Go, Rust, Java Spring, Laravel, PHP, Docker Compose. No telemetry.",
  "type": "module",
  "main": "index.js",
  "bin": {
    "setupkaro": "bin/setupkaro.js"
  },
  "scripts": {
    "dev": "node bin/setupkaro.js",
    "start": "node bin/setupkaro.js"
  },
  "keywords": [
    "cli",
    "boilerplate",
    "scaffolding",
    "project-generator",
    "starter-template",
    "npx",
    "zero-install",
    "typescript boilerplate",
    "react starter",
    "nextjs template",
    "fastapi boilerplate",
    "go microservice template",
    "rust cli template",
    "java spring boot starter",
    "laravel starter",
    "php boilerplate",
    "docker compose template",
    "ci-cd",
    "github-actions"
  ],
  "author": "setupkaro",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "templates",
    "README.md",
    "LICENSE"
  ]
}